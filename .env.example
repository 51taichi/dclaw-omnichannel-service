PORT=3000

# Your purchased WorkTool robot id.
ROBOT_ID=replace_with_your_robot_id

# WorkTool API host.
WORKTOOL_BASE_URL=https://api.worktool.ymdyes.cn

# Public HTTPS base URL that WorkTool can call, for example:
# https://your-domain.com
# https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# Optional shared secret added to callback URLs as ?secret=xxx.
# Keep empty if you do not want callback URL verification.
CALLBACK_SECRET=
