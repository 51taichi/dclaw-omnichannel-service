PORT=8765
HOST=0.0.0.0

# Optional single-bot compatibility value. Multi-bot callbacks use /worktool/:botId.
ROBOT_ID=replace_with_your_robot_id

# WorkTool API host.
WORKTOOL_BASE_URL=https://api.worktool.ymdyes.cn

# Public HTTPS base URL that WorkTool can call, for example:
# https://your-domain.com
# https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# Required for WorkTool callbacks. It is added to callback URLs as ?secret=xxx.
CALLBACK_SECRET=replace_with_a_random_secret

# Used only to initialize the singleton database administrator password on the
# first upgraded startup. After initialization, change it in /admin/ or run
# npm run admin:reset-password. Later .env changes do not overwrite the database password.
ADMIN_API_KEY=replace_with_a_random_admin_key
# Global administrator browser sessions expire after this many hours.
ADMIN_SESSION_TTL_HOURS=8
# Bot unlock sessions expire after this many hours.
BOT_SESSION_TTL_HOURS=8

# Optional upload settings.
UPLOAD_MAX_MB=100
# Comma-separated browser origins allowed to call POST /api/uploads.
# Example: https://app.example.com,https://admin.example.com
UPLOAD_ALLOWED_ORIGINS=

# Optional multi-bot bootstrap config.
BOTS_CONFIG_PATH=./config/bots.json

# Optional single-bot DClaw bootstrap config.
DCLAW_AGENT_ID=
DCLAW_BASE_URL=
DCLAW_PUBLIC_ID=
DCLAW_AGENT_API_URL=
DCLAW_AGENT_API_KEY=
DCLAW_AGENT_TIMEOUT_MS=120000
DCLAW_AGENT_FORMAT_RETRY_TIMEOUT_MS=30000
DCLAW_AGENT_MAX_ATTEMPTS=2
DCLAW_AGENT_CONCURRENCY=3
AGENT_FAILURE_FALLBACK_REPLY=刚刚这边有点卡，我稍后回复你哈

# Optional flow node activation worker settings.
ACTIVATION_WORKER_ENABLED=true
ACTIVATION_WORKER_INTERVAL_MS=10000
ACTIVATION_WORKER_BATCH_SIZE=20
ACTIVATION_WORKER_STALE_PROCESSING_MS=300000
ACTIVATION_SEND_DELAY_MS=500
ACTIVATION_MAX_CONCURRENT_AGENT_CALLS=2
# Absorb duplicate WorkTool friend-added signals for the same conversation.
FRIEND_ADDED_SIGNAL_DEDUPE_SECONDS=30
# Optional business cooldown before treating a later callback as a fresh re-add.
FRIEND_ADDED_REENTRY_COOLDOWN_MINUTES=10

# Optional WeCom native tag synchronization worker settings. Each Bot controls
# whether nightly synchronization is enabled and its Beijing-time night window.
TAG_SYNC_WORKER_INTERVAL_MS=2000
TAG_SYNC_WORKER_LEASE_MS=120000
TAG_SYNC_REALTIME_ACTIVITY_TTL_MS=900000

# 群定时任务。到点后在该群现有的普通 Agent 会话中执行，
# 不轮询上游 WorkTool 群消息，也不建设独立群历史同步链路。
GROUP_AUTOMATION_WORKER_ENABLED=true
GROUP_AUTOMATION_OCCURRENCE_INTERVAL_MS=2000
GROUP_AUTOMATION_LEASE_MS=300000
GROUP_AUTOMATION_BATCH_SIZE=10

# AI 经营驾驶舱夜间流水线。默认按服务器本地时间 01:00 聚合、
# 02:00 对账、03:00 生成报告、09:00 发送。
COCKPIT_WORKER_ENABLED=true

# Debug auto-reply is configured in /console and stored in SQLite.
