PORT=8765
HOST=0.0.0.0

# Runtime storage. Keep this service isolated from any former WeChat deployment.
DATA_DIR=./data
DATABASE_PATH=

# Public HTTPS origin used to build each Whapi webhook URL.
# Example: https://whatsapp.example.com
PUBLIC_BASE_URL=

# Required. Encrypts Whapi API tokens at rest. Generate with: openssl rand -hex 32
CHANNEL_TOKEN_ENCRYPTION_KEY=

# Channel webhook reconciliation worker.
CHANNEL_WEBHOOK_WORKER_ENABLED=true
CHANNEL_WEBHOOK_WORKER_INTERVAL_MS=300000

# Initializes the singleton administrator password on the first startup only.
ADMIN_API_KEY=replace_with_a_random_admin_key
ADMIN_SESSION_TTL_HOURS=8
BOT_SESSION_TTL_HOURS=8

# Optional multi-Bot and DClaw bootstrap configuration.
BOTS_CONFIG_PATH=./config/bots.json
BOT_ID=
DCLAW_AGENT_ID=
DCLAW_BASE_URL=
DCLAW_PUBLIC_ID=
DCLAW_AGENT_API_KEY=
DCLAW_AGENT_TIMEOUT_MS=120000
DCLAW_AGENT_FORMAT_RETRY_TIMEOUT_MS=30000
DCLAW_AGENT_MAX_ATTEMPTS=2
DCLAW_AGENT_CONCURRENCY=3
AGENT_FAILURE_FALLBACK_REPLY=刚刚这边有点卡，我稍后回复你哈

# Uploads and retained inbound media.
UPLOAD_MAX_MB=100
UPLOAD_ALLOWED_ORIGINS=
UPLOAD_RETENTION_HOURS=168
UPLOAD_CLEANUP_INTERVAL_MINUTES=60

# Private-chat flow workers.
ACTIVATION_WORKER_ENABLED=true
ACTIVATION_WORKER_INTERVAL_MS=10000
ACTIVATION_WORKER_BATCH_SIZE=20
ACTIVATION_WORKER_STALE_PROCESSING_MS=300000
ACTIVATION_SEND_DELAY_MS=500
ACTIVATION_MAX_CONCURRENT_AGENT_CALLS=2
TAG_ACTIVATION_WORKER_ENABLED=true
TAG_ACTIVATION_WORKER_INTERVAL_MS=10000
TAG_ACTIVATION_WORKER_BATCH_SIZE=20
TAG_ACTIVATION_WORKER_STALE_PROCESSING_MS=300000
TAG_ACTIVATION_SEND_DELAY_MS=500
TAG_ACTIVATION_MAX_CONCURRENT_AGENT_CALLS=2

# Proactive and group automation workers.
PROACTIVE_WORKER_ENABLED=true
PROACTIVE_WORKER_INTERVAL_MS=2000
PROACTIVE_MAX_ATTEMPTS=3
PROACTIVE_MAX_TARGETS=500
GROUP_AUTOMATION_WORKER_ENABLED=true
GROUP_AUTOMATION_OCCURRENCE_INTERVAL_MS=2000
GROUP_AUTOMATION_LEASE_MS=300000
GROUP_AUTOMATION_BATCH_SIZE=10

# DClaw conversation-reset and operations-report workers.
CONVERSATION_RESET_WORKER_ENABLED=true
CONVERSATION_RESET_WORKER_INTERVAL_MS=10000
CONVERSATION_RESET_WORKER_STALE_PROCESSING_MS=300000
CONVERSATION_RESET_RETRY_DELAY_MS=30000
DCLAW_CONVERSATION_RESET_TIMEOUT_MS=30000
COCKPIT_WORKER_ENABLED=true
