PORT=8765
HOST=0.0.0.0

# Optional single-bot compatibility value. Multi-bot callbacks use /worktool/:botId.
ROBOT_ID=replace_with_your_robot_id

# WorkTool API host.
WORKTOOL_BASE_URL=https://api.worktool.ymdyes.cn

# Public HTTPS base URL that WorkTool can call, for example:
# https://your-domain.com
# https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# Optional shared secret added to callback URLs as ?secret=xxx.
# Keep empty if you do not want callback URL verification.
CALLBACK_SECRET=

# Optional admin key for management APIs. Send it as x-api-key.
ADMIN_API_KEY=
# Bot unlock sessions expire after this many hours.
BOT_SESSION_TTL_HOURS=8

# Optional upload settings.
UPLOAD_MAX_MB=100
# Comma-separated browser origins allowed to call POST /api/uploads.
# Example: https://app.example.com,https://admin.example.com
UPLOAD_ALLOWED_ORIGINS=

# Optional multi-bot bootstrap config.
BOTS_CONFIG_PATH=./config/bots.json

# Optional single-bot DClaw bootstrap config.
DCLAW_AGENT_ID=
DCLAW_BASE_URL=
DCLAW_PUBLIC_ID=
DCLAW_AGENT_API_URL=
DCLAW_AGENT_API_KEY=
DCLAW_AGENT_TIMEOUT_MS=25000
DCLAW_AGENT_MAX_ATTEMPTS=2

# Debug auto-reply is configured in /console and stored in SQLite.
